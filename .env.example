# ============================================================
# 迈科咖啡 · Docker Compose 环境变量（项目根目录）
# 复制为 .env 并填入真实值
#   cp .env.example .env && vim .env
# ============================================================

# MySQL root 密码（Docker 首次启动创建，后续不可改）
DB_ROOT_PASSWORD=change-me-root

# MySQL 应用用户 & 密码（Docker 自动创建，Django 连接用）
DB_USER=mkcoffee
DB_PASSWORD=change-me-app

# 数据库名
DB_NAME=mkcoffee
