# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── 企业微信通知 ────────────────────────────────────────────────
# 群机器人 Webhook 完整地址。留空则留言仍会入库，但不会推送到群，
# 服务端会记录一条 "WECOM_WEBHOOK 未配置" 的 warn 日志。
WECOM_WEBHOOK=

# ── 运行时（生产）─────────────────────────────────────────────
# PORT=3100
# HOST=172.17.0.1         # 生产固定指向 Docker 网关，不要用 0.0.0.0
