# ============================================================
# 迈科咖啡 · 环境变量模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================================

# --- 环境选择 ---
# dev: 开发环境（DEBUG=True，全放行）
# production: 生产环境（DEBUG=False，白名单策略）
DJANGO_ENV=dev

# --- Django 核心 ---
# 生产环境务必使用强随机字符串！
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# --- 数据库（MySQL） ---
# Docker 环境：DB_HOST=db，不需要 DB_SOCKET
# 本地直连：DB_HOST=127.0.0.1，DB_SOCKET=/home/mbc/MySQL8/run/mysql.sock
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mkcoffee
DB_USER=root
DB_PASSWORD=your-db-password
# Docker compose 中 db 服务需要的 root 密码（本地开发可忽略）
DB_ROOT_PASSWORD=
# DB_SOCKET=/home/mbc/MySQL8/run/mysql.sock  # Docker 环境下注释掉此行

# --- 微信小程序 ---
# 从小程序后台获取：开发 → 开发管理 → 开发设置
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret

# --- 微信支付 V3（可选，未配置时降级为模拟支付） ---
# 等拿到商户号后填入以下 6 个变量即可启用真实支付
WXPAY_ENABLED=false
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
# 商户私钥：支持 PEM 原文，或文件路径（推荐，避免 .env 多行转义问题）
# 路径方式：把 apiclient_key.pem 放到 backend/wxpay/ 后填 /app/wxpay/apiclient_key.pem
WXPAY_PRIVATE_KEY=
WXPAY_NOTIFY_URL=https://api.mk-coffee.cn/api/payments/callback/
# 微信支付公钥模式（2024 起新商户无平台证书，必须配置否则回调验签失败）：
# 商户平台 → 账户中心 → API 安全 → 微信支付公钥 → 查看（复制公钥 + 公钥ID）
WXPAY_PUBLIC_KEY=
WXPAY_PUBLIC_KEY_ID=
WXPAY_CERT_PATH=

# --- 生产环境（DJANGO_ENV=production 时生效） ---
# 多个值用英文逗号分隔
DJANGO_ALLOWED_HOSTS=api.mk-coffee.com,mk-coffee.com
CORS_ALLOWED_ORIGINS=https://api.mk-coffee.com
DJANGO_LOG_LEVEL=WARNING

# --- 企业微信群机器人（订单支付成功通知，未配置则不推送） ---
# 在企业微信群 → 添加群机器人 → 复制 webhook 地址
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key-here
