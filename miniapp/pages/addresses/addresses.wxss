/* 地址卡片 */
.addr-card {
  margin: 16rpx 24rpx; padding: 28rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(92,61,46,.04);
}
.addr-header { display: flex; justify-content: space-between; align-items: center; }
.addr-contact { display: flex; gap: 16rpx; }
.addr-name { font-size: 30rpx; font-weight: 700; color: #2c2416; }
.addr-phone { font-size: 26rpx; color: #8c7b6e; }
.addr-default { font-size: 22rpx; color: #e8873a; background: #fff8f2; padding: 4rpx 16rpx; border-radius: 20rpx; }
.addr-detail { font-size: 26rpx; color: #8c7b6e; margin-top: 12rpx; line-height: 1.5; }
.addr-actions { display: flex; gap: 24rpx; margin-top: 16rpx; font-size: 24rpx; color: #5c3d2e; padding-top: 16rpx; border-top: 1rpx solid #fefaf6; }

/* 添加按钮 */
.add-btn {
  margin: 32rpx 24rpx; padding: 24rpx; text-align: center;
  background: linear-gradient(135deg, #5c3d2e, #7a5a47);
  color: #fff; border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
}

/* 表单 */
.addr-form { padding: 24rpx; }
.form-title { font-size: 34rpx; font-weight: 800; color: #2c2416; margin-bottom: 32rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #8c7b6e; display: block; margin-bottom: 8rpx; }
.form-input {
  width: 100%; height: 76rpx; padding: 0 24rpx; font-size: 28rpx; line-height: 76rpx;
  background: #fefaf6; border-radius: 12rpx; box-sizing: border-box;
}
.form-actions { display: flex; gap: 16rpx; margin-top: 40rpx; }
.btn-cancel {
  flex: 1; text-align: center; padding: 24rpx;
  background: #fefaf6; color: #8c7b6e; border-radius: 40rpx; font-size: 28rpx;
}
.btn-save {
  flex: 1; text-align: center; padding: 24rpx;
  background: linear-gradient(135deg, #e8873a, #f0a060);
  color: #fff; border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
}
