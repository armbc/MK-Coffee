/* ===== 购物车页面 ===== */
.cart-page {
  min-height: 100vh;
  padding-bottom: 240rpx;
}

/* ===== 条目 ===== */
.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(92, 61, 46, 0.04);
}

/* 复选框 */
.check-wrap { padding: 8rpx; margin-right: 12rpx; }
.checkbox {
  width: 38rpx; height: 38rpx;
  border: 2rpx solid #e0d5c9;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #fff;
}
.checkbox.checked {
  background: linear-gradient(135deg, #e8873a, #f0a060);
  border-color: #e8873a;
}

/* 图片 */
.item-img {
  width: 140rpx; height: 140rpx;
  background: linear-gradient(135deg, #fefaf6, #f5ebe0);
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx; flex-shrink: 0;
}
.img-icon { font-size: 50rpx; opacity: 0.5; }

/* 信息 */
.item-info { flex: 1; min-width: 0; }
.item-name {
  font-size: 28rpx; font-weight: 700; color: #2c2416;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.item-spec { font-size: 22rpx; color: #b0a59a; margin-top: 4rpx; }
.item-price {
  font-size: 26rpx; color: #e8873a; font-weight: 700; margin-top: 8rpx;
}

/* 数量 */
.item-qty { display: flex; align-items: center; margin: 0 16rpx; flex-shrink: 0; }
.item-qty .qty-btn {
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center; font-size: 28rpx;
  color: #5c3d2e; background: #fefaf6; border-radius: 8rpx;
}
.item-qty .qty-value {
  width: 60rpx; text-align: center; font-size: 26rpx; font-weight: 700;
}

/* 右侧 */
.item-right { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; min-width: 100rpx; }
.item-subtotal { font-size: 28rpx; font-weight: 800; color: #e8873a; }
.item-del { font-size: 22rpx; color: #b0a59a; margin-top: 8rpx; }

/* ===== 空状态 ===== */
.empty-link {
  display: inline-block; margin-top: 32rpx;
  padding: 16rpx 64rpx;
  background: linear-gradient(135deg, #5c3d2e, #7a5a47);
  color: #fff; border-radius: 40rpx; font-size: 28rpx;
}

/* ===== 底部栏 ===== */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0ebe3;
  box-shadow: 0 -4rpx 20rpx rgba(92, 61, 46, 0.06);
  z-index: 100;
}
.bottom-check { display: flex; align-items: center; gap: 8rpx; }
.all-label { font-size: 26rpx; color: #2c2416; }
.bottom-total { flex: 1; text-align: right; margin-right: 24rpx; }
.total-label { font-size: 26rpx; color: #2c2416; }
.total-price { font-size: 36rpx; font-weight: 800; color: #e8873a; }
.btn-submit {
  width: 160rpx; height: 72rpx; line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #e8873a, #f0a060);
  color: #fff; border-radius: 36rpx;
  font-size: 28rpx; font-weight: 700;
}
.btn-submit.disabled { background: #e0d5c9; color: #fff; }
/* 优惠券选择行 */
.coupon-row {
  position: fixed;
  left: 0; right: 0;
  bottom: 108rpx;
  display: flex; align-items: center;
  padding: 18rpx 24rpx;
  background: #fffdf8;
  border-top: 1rpx solid #f5efe6;
  z-index: 9;
}
.coupon-label { font-size: 26rpx; color: #6b5a4d; margin-right: 16rpx; }
.coupon-value { flex: 1; font-size: 26rpx; color: #b8a99b; text-align: right; }
.coupon-value.active { color: #e8873a; font-weight: 700; }
.coupon-arrow { color: #c9bdb0; margin-left: 8rpx; font-size: 28rpx; }

/* 应付金额与划线原价 */
.total-origin {
  font-size: 22rpx; color: #b8a99b;
  text-decoration: line-through;
  margin-left: 10rpx;
}
