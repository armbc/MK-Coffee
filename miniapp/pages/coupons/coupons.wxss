/* Tab */
.tab-bar {
  display: flex; background: #fff;
  border-bottom: 1rpx solid #f0ebe3;
}
.tab-item {
  flex: 1; text-align: center; padding: 28rpx 0;
  font-size: 28rpx; color: #8c7b6e; position: relative;
}
.tab-item.active {
  color: #5c3d2e; font-weight: 700;
}
.tab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 48rpx; height: 4rpx; background: #e8873a; border-radius: 2rpx;
}

/* 优惠券卡片 */
.coupon-card {
  display: flex; margin: 24rpx 24rpx 0;
  background: #fff; border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(92, 61, 46, 0.06);
}
.coupon-card.disabled { opacity: 0.5; }

.coupon-left {
  width: 200rpx; padding: 32rpx 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #e8873a, #f0a060);
  color: #fff;
}
.disabled .coupon-left {
  background: linear-gradient(135deg, #b0a59a, #ccc);
}
.coupon-value {
  font-size: 44rpx; font-weight: 800;
}
.coupon-condition {
  font-size: 22rpx; opacity: 0.8; margin-top: 8rpx;
}

.coupon-right {
  flex: 1; padding: 24rpx; display: flex; flex-direction: column; justify-content: center;
}
.coupon-name { font-size: 28rpx; font-weight: 700; color: #2c2416; }
.coupon-stock { font-size: 22rpx; color: #b0a59a; margin-top: 8rpx; }
.coupon-meta { font-size: 22rpx; color: #b0a59a; margin-top: 8rpx; }
.coupon-status { font-size: 24rpx; font-weight: 600; margin-top: 8rpx; }
.coupon-status.used { color: #909399; }
.coupon-status.expired { color: #e74c3c; }

.claim-btn {
  align-self: flex-end;
  margin-top: 12rpx; padding: 10rpx 28rpx;
  background: linear-gradient(135deg, #e8873a, #f0a060);
  color: #fff; border-radius: 28rpx; font-size: 24rpx; font-weight: 600;
}

/* 空状态 */
.empty-state { padding: 160rpx 0; }
.empty-icon { font-size: 80rpx; opacity: 0.6; text-align: center; }
.empty-text { font-size: 28rpx; color: #b0a59a; margin-top: 16rpx; text-align: center; }
