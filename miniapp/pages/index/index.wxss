/* ===== 轮播图 ===== */
.banner-swiper {
  width: 100%;
  height: 400rpx;
}
.banner-slide {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #5c3d2e 0%, #7a5a47 40%, #e8873a 100%);
}
.banner-tag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  letter-spacing: 6rpx;
  margin-bottom: 12rpx;
}
.banner-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* ===== 分类横滚条 ===== */
.category-bar {
  background: #fff;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0ebe3;
}
.category-bar-inner {
  white-space: nowrap;
  padding: 0 24rpx;
}
.category-item {
  position: relative;
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #8c7b6e;
  background: #fefaf6;
  border-radius: 36rpx;
  font-weight: 500;
  transition: all 0.25s ease;
}
.category-item.active {
  color: #fff;
  background: linear-gradient(135deg, #5c3d2e, #7a5a47);
  font-weight: 600;
}
.cat-dot {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #e8873a;
  border-radius: 50%;
}

/* ===== 区域标题 ===== */
.section-header {
  padding: 32rpx 0 24rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #5c3d2e;
}
.section-sub {
  font-size: 24rpx;
  color: #b0a59a;
  margin-top: 6rpx;
}

/* ===== 商品网格 ===== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
}

/* ===== 商品卡片 ===== */
.product-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(92, 61, 46, 0.06);
  transition: transform 0.15s ease;
  margin-bottom: 0;
}
.product-card:active {
  transform: scale(0.97);
}

.product-img-wrap {
  position: relative;
  width: 100%;
}
.product-img-placeholder {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(135deg, #fefaf6, #f5ebe0);
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-img-icon {
  font-size: 72rpx;
  opacity: 0.6;
}
.product-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #e8873a, #f0a060);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 6rpx;
}

.product-info {
  padding: 16rpx 20rpx 18rpx;
}
.product-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c2416;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-cat {
  font-size: 22rpx;
  color: #b0a59a;
  margin-top: 4rpx;
}
.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.product-price {
  font-size: 30rpx;
  font-weight: 800;
  color: #e8873a;
}
.product-buy-icon {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #e8873a, #f0a060);
  border-radius: 50%;
  font-weight: 300;
}
