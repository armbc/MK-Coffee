.store-map { width: 100%; height: 520rpx; }
.store-info { padding: 28rpx; }
.store-name { font-size: 36rpx; font-weight: 800; color: #2c2416; margin-bottom: 24rpx; }
.info-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.info-icon { font-size: 28rpx; width: 48rpx; }
.info-text { font-size: 26rpx; color: #8c7b6e; }

.store-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.action-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 24rpx; border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
}
.action-btn.call { background: #fefaf6; color: #5c3d2e; }
.action-btn.nav { background: linear-gradient(135deg, #e8873a, #f0a060); color: #fff; }
