<view class="page-body" style="max-width: {{maxWidth > 0 ? maxWidth + 'px' : 'none'}}; margin: {{maxWidth > 0 ? '0 auto' : '0'}};" bindtouchstart="onSwipeStart" bindtouchend="onSwipeEnd">
  <!-- 顶部 -->
  <view class="user-header">
    <view class="header-bg"></view>
    <view class="user-card">
      <view wx:if="{{!loggedIn}}" class="login-prompt">
        <view class="avatar-placeholder">👤</view>
        <view class="login-text">登录后享受更多服务</view>
        <view class="login-btn" bindtap="doLogin">微信一键登录</view>
      </view>
      <view wx:else class="user-info">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">👤</view>
        <view class="info-right">
          <view class="nickname">{{userInfo.nickname || '咖啡爱好者'}}</view>
          <view class="phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</view>
          <view class="edit-profile-btn" bindtap="openEdit">✎ 编辑资料</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goOrders">
      <view class="menu-icon-box bg-orange">📦</view>
      <text class="menu-label">我的订单</text>
      <text class="menu-desc">查看订单状态</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAddress">
      <view class="menu-icon-box bg-brown">📍</view>
      <text class="menu-label">收货地址</text>
      <text class="menu-desc">管理配送地址</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCoupons">
      <view class="menu-icon-box bg-green">🎟️</view>
      <text class="menu-label">优惠券</text>
      <text class="menu-desc">查看可用优惠</text>
      <text class="menu-arrow">›</text>
    </view>
    <!-- 门店导航：生产型企业暂未设立对外门店，先注释隐藏；设立体验店后取消注释恢复 -->
    <!--
    <view class="menu-item" bindtap="goStore">
      <view class="menu-icon-box bg-blue">🏪</view>
      <text class="menu-label">门店导航</text>
      <text class="menu-desc">查看门店位置</text>
      <text class="menu-arrow">›</text>
    </view>
    -->
  </view>

  <!-- 退出 -->
  <view class="logout-section" wx:if="{{loggedIn}}">
    <view class="logout-btn" bindtap="doLogout">退出登录</view>
  </view>

  <!-- 品牌信息 -->
  <view class="brand-footer">
    <text class="brand-name">MK-Coffee 迈科咖啡</text>
    <text class="brand-version">v1.0.0</text>
    <text class="brand-icp">苏ICP备2026059759号</text>
  </view>

  <!-- 编辑资料弹窗 -->
  <view class="edit-mask" wx:if="{{showEdit}}" bindtap="closeEdit">
    <view class="edit-panel" catchtap="noop">
      <view class="edit-title">编辑资料</view>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{editAvatar}}" class="edit-avatar" src="{{editAvatar}}" mode="aspectFill" />
        <view wx:else class="edit-avatar-placeholder">👤</view>
        <text class="avatar-hint">点击选择头像</text>
      </button>
      <view class="nickname-row">
        <text class="nickname-label">昵称</text>
        <input class="nickname-input" type="nickname" value="{{editNickname}}" bindinput="onNicknameInput" placeholder="请输入昵称" maxlength="20" />
      </view>
      <view class="edit-btns">
        <view class="edit-btn cancel" bindtap="closeEdit">取消</view>
        <view class="edit-btn save" bindtap="saveProfile">保存</view>
      </view>
    </view>
  </view>
</view>
